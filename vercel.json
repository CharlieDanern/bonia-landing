{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/app/:path(.*)?", "has": [{ "type": "host", "value": "bonia.net" }], "destination": "https://bonia.vn/app/:path", "permanent": true },
    { "source": "/admin/:path(.*)?", "has": [{ "type": "host", "value": "bonia.net" }], "destination": "https://bonia.vn/admin/:path", "permanent": true }
  ],
  "rewrites": [
    { "source": "/app/:path*", "destination": "/app/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/business", "destination": "/business.html" }
  ]
}
